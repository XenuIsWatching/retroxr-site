---
interface Props {
	src: string;
	poster?: ImageMetadata;
	caption: string;
	alt: string;
	sound?: boolean;
}

const { src, poster, caption, alt, sound = false } = Astro.props;
---

<figure class="rxr-clip">
	{
		sound ? (
			<video
				src={src}
				poster={poster?.src}
				controls
				preload="metadata"
				playsinline
				aria-label={alt}
			/>
		) : (
			<video
				src={src}
				poster={poster?.src}
				autoplay
				loop
				muted
				playsinline
				aria-label={alt}
			/>
		)
	}
	<figcaption>{caption}</figcaption>
</figure>

<style>
	.rxr-clip {
		margin: 1.5rem 0;
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 0.75rem;
		overflow: hidden;
		background: var(--rxr-ink);
	}
	.rxr-clip video {
		display: block;
		width: 100%;
		height: auto;
		background: var(--rxr-ink);
	}
	.rxr-clip figcaption {
		padding: 0.7rem 1rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		border-top: 1px solid var(--sl-color-hairline-shade);
	}
</style>
